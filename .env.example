DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
PORT=4000
FRONTEND_URL=http://localhost:3000
WORKER_CONCURRENCY=5
# Minimum spacing between sends per sender; hourly send quota per sender
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
# Create a free mailbox at https://ethereal.email and paste the SMTP credentials here
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=
ETHEREAL_FROM=reachinbox@test.local
# Render free tier blocks outbound SMTP (25/465/587), so SMTP always times
# out there. Set these to send over HTTPS instead (local Ethereal SMTP is
# used while RESEND_API_KEY is empty). Free at https://resend.com; without
# a verified domain keep RESEND_FROM=onboarding@resend.dev and send only to
# your own account email.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
ELASTICSEARCH_URL=http://localhost:9200
# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# JWT signing secret — MUST be set to a long random value in production
JWT_SECRET=dev-secret-change-me
# Slack OAuth (PKCE, no client secret used) — create an app at https://api.slack.com/apps, enable incoming-webhooks
SLACK_CLIENT_ID=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
# 32-byte hex key for encrypting stored Slack credentials — generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Bull Board dashboard (no login — keep false unless proxied; enable with "true" locally only)
BULL_BOARD_ENABLED=false
# Bound for BullMQ enqueue while Redis is unreachable
QUEUE_ADD_TIMEOUT_MS=10000
# Frontend build-time backend origin for /api/* rewrites (Vercel + Render split)
NEXT_PUBLIC_API=http://localhost:4000
