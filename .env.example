DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
PORT=4000
FRONTEND_URL=http://localhost:3000
WORKER_CONCURRENCY=5
# Minimum spacing between sends per sender; hourly send quota per sender
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
# Create a free mailbox at https://ethereal.email and paste the SMTP credentials here
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=
ETHEREAL_FROM=reachinbox@test.local
ELASTICSEARCH_URL=http://localhost:9200
# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# JWT signing secret — MUST be set to a long random value in production
JWT_SECRET=dev-secret-change-me
# Slack OAuth (create an app at https://api.slack.com/apps, enable incoming webhooks)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
# 32-byte hex key for encrypting stored Slack credentials — generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Bull Board dashboard (development-only: no login — set false in production or proxy-protect /admin/queues)
BULL_BOARD_ENABLED=true
