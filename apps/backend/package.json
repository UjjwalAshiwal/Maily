{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "(prisma migrate deploy || echo 'MIGRATE_DEPLOY_FAILED_CONTINUING_WITH_EXISTING_SCHEMA') && node dist/server.js",
    "test": "tsx --test --test-force-exit \"src/**/*.test.ts\"",
    "search:index": "tsx src/scripts/search-index.ts"
  },
  "dependencies": {
    "@bull-board/api": "^5.11.0",
    "@bull-board/express": "^5.11.0",
    "@elastic/elasticsearch": "^8.13.0",
    "@prisma/client": "^5.14.0",
    "bullmq": "^5.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.13",
    "pino": "^9.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/nodemailer": "^6.4.15",
    "@types/node": "^20.12.12",
    "prisma": "^5.14.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
